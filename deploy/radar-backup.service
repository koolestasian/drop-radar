[Unit]
Description=Drop Radar nightly SQLite backup
After=radar.service

[Service]
Type=oneshot
User=radar
Group=radar
WorkingDirectory=/opt/radar/zero2sudo-opportunity-monitor
EnvironmentFile=/opt/radar/radar.env
ExecStart=/opt/radar/zero2sudo-opportunity-monitor/.venv/bin/python -m radar backup --keep 14
ReadWritePaths=/opt/radar/data
