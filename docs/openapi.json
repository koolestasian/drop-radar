{
  "components": {
    "schemas": {
      "Action": {
        "properties": {
          "notes": {
            "title": "Notes",
            "type": "string"
          },
          "status": {
            "description": "this user's status; legacy imports may say 'actioned'",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "notes"
        ],
        "title": "Action",
        "type": "object"
      },
      "ActionPatch": {
        "properties": {
          "notes": {
            "anyOf": [
              {
                "maxLength": 10000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "status": {
            "anyOf": [
              {
                "enum": [
                  "new",
                  "saved",
                  "applied",
                  "interview",
                  "offer",
                  "rejected",
                  "ignored"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status"
          }
        },
        "title": "ActionPatch",
        "type": "object"
      },
      "AuthResult": {
        "properties": {
          "me": {
            "$ref": "#/components/schemas/Me"
          },
          "token": {
            "description": "send as 'Authorization: Bearer <token>'; shown once, kept only as a hash",
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token",
          "me"
        ],
        "title": "AuthResult",
        "type": "object"
      },
      "CompanyConfig": {
        "properties": {
          "ats": {
            "description": "greenhouse | lever | ashby | smartrecruiters | workday",
            "title": "Ats",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "slug": {
            "description": "board slug; workday: tenant.wdN/site",
            "title": "Slug",
            "type": "string"
          },
          "tier": {
            "default": "B",
            "description": "S | A | B | C (S/A polled every 2 min)",
            "title": "Tier",
            "type": "string"
          }
        },
        "required": [
          "name",
          "ats",
          "slug"
        ],
        "title": "CompanyConfig",
        "type": "object"
      },
      "Credentials": {
        "properties": {
          "password": {
            "maxLength": 256,
            "title": "Password",
            "type": "string"
          },
          "username": {
            "maxLength": 64,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "Credentials",
        "type": "object"
      },
      "FeedConfig": {
        "properties": {
          "kind": {
            "default": "rss",
            "title": "Kind",
            "type": "string"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "title": "FeedConfig",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "InstagramConfig": {
        "properties": {
          "interval_s": {
            "default": 300.0,
            "title": "Interval S",
            "type": "number"
          },
          "priority": {
            "default": 5,
            "title": "Priority",
            "type": "integer"
          },
          "user_id": {
            "default": "",
            "description": "numeric id; skips the throttled profile lookup",
            "title": "User Id",
            "type": "string"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username"
        ],
        "title": "InstagramConfig",
        "type": "object"
      },
      "InstagramRelay": {
        "properties": {
          "stories": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "maxItems": 1000,
            "title": "Stories",
            "type": "array"
          },
          "username": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "stories"
        ],
        "title": "InstagramRelay",
        "type": "object"
      },
      "Login": {
        "properties": {
          "password": {
            "maxLength": 256,
            "title": "Password",
            "type": "string"
          },
          "username": {
            "maxLength": 64,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "Login",
        "type": "object"
      },
      "Match": {
        "properties": {
          "ok": {
            "description": "would alert this user (the same rule the phone uses)",
            "title": "Ok",
            "type": "boolean"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "title": "Reasons",
            "type": "array"
          }
        },
        "required": [
          "ok",
          "reasons"
        ],
        "title": "Match",
        "type": "object"
      },
      "Me": {
        "properties": {
          "account": {
            "default": false,
            "description": "made through sign-up (kept in the database), not listed in users.yaml",
            "title": "Account",
            "type": "boolean"
          },
          "alerts_enabled": {
            "description": "a delivery channel is configured; device receipt is not verified",
            "title": "Alerts Enabled",
            "type": "boolean"
          },
          "guest": {
            "default": false,
            "description": "true for a visitor who is not logged in: read-only, default profile",
            "title": "Guest",
            "type": "boolean"
          },
          "notification_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "this user's private ntfy subscription URL; no API token",
            "title": "Notification Url"
          },
          "sources": {
            "title": "Sources",
            "type": "integer"
          },
          "user": {
            "title": "User",
            "type": "string"
          },
          "username": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "the name this user signs in with, if they have set one",
            "title": "Username"
          }
        },
        "required": [
          "user",
          "sources",
          "alerts_enabled",
          "notification_url"
        ],
        "title": "Me",
        "type": "object"
      },
      "Metrics": {
        "properties": {
          "items_per_day": {
            "additionalProperties": {
              "type": "integer"
            },
            "description": "last 7 days, items your sources saw first that day",
            "title": "Items Per Day",
            "type": "object"
          },
          "latency": {
            "description": "drop latency per source, your sources only",
            "items": {
              "$ref": "#/components/schemas/SourceLatency"
            },
            "title": "Latency",
            "type": "array"
          },
          "llm_daily_budget": {
            "title": "Llm Daily Budget",
            "type": "integer"
          },
          "llm_tokens_today": {
            "description": "shared by every user",
            "title": "Llm Tokens Today",
            "type": "integer"
          }
        },
        "required": [
          "latency",
          "items_per_day",
          "llm_tokens_today",
          "llm_daily_budget"
        ],
        "title": "Metrics",
        "type": "object"
      },
      "Opportunity": {
        "properties": {
          "action": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Action"
              },
              {
                "type": "null"
              }
            ],
            "description": "this user's status/notes; nobody else's"
          },
          "backfill": {
            "description": "already open when your sources first looked (never alerted), not a live drop",
            "title": "Backfill",
            "type": "boolean"
          },
          "category": {
            "title": "Category",
            "type": "string"
          },
          "company": {
            "title": "Company",
            "type": "string"
          },
          "company_domain": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "the company's web domain, for its logo; None until looked up, or when no confident match",
            "title": "Company Domain"
          },
          "deadline": {
            "title": "Deadline",
            "type": "string"
          },
          "first_seen": {
            "title": "First Seen",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "location": {
            "description": "display form, \"City - Country\" (\"A, B - Country; C - Other\" for several)",
            "title": "Location",
            "type": "string"
          },
          "location_raw": {
            "default": "",
            "description": "the place exactly as the source wrote it",
            "title": "Location Raw",
            "type": "string"
          },
          "match": {
            "$ref": "#/components/schemas/Match"
          },
          "published_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Published At"
          },
          "role_track": {
            "title": "Role Track",
            "type": "string"
          },
          "season": {
            "title": "Season",
            "type": "string"
          },
          "sources": {
            "description": "this user's sources that saw it",
            "items": {
              "type": "string"
            },
            "title": "Sources",
            "type": "array"
          },
          "status": {
            "description": "the posting itself: New, Closed, ...",
            "title": "Status",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "company",
          "location",
          "url",
          "deadline",
          "status",
          "first_seen",
          "published_at",
          "category",
          "role_track",
          "season",
          "sources",
          "backfill",
          "match",
          "action"
        ],
        "title": "Opportunity",
        "type": "object"
      },
      "Page": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Opportunity"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "required": [
          "items",
          "next_cursor"
        ],
        "title": "Page",
        "type": "object"
      },
      "ProfileConfig": {
        "properties": {
          "company_tiers": {
            "additionalProperties": {
              "type": "string"
            },
            "default": {},
            "title": "Company Tiers",
            "type": "object"
          },
          "exclude": {
            "default": [],
            "description": "any of these in the title rules it out",
            "items": {
              "type": "string"
            },
            "title": "Exclude",
            "type": "array"
          },
          "grad_year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "target season year, e.g. 2027",
            "title": "Grad Year"
          },
          "keywords": {
            "default": [],
            "description": "...and one of these (the level)",
            "items": {
              "type": "string"
            },
            "title": "Keywords",
            "type": "array"
          },
          "locations": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Locations",
            "type": "array"
          },
          "roles": {
            "default": [],
            "description": "the track: a title needs one of these...",
            "items": {
              "type": "string"
            },
            "title": "Roles",
            "type": "array"
          }
        },
        "title": "ProfileConfig",
        "type": "object"
      },
      "RepoConfig": {
        "properties": {
          "name": {
            "description": "owner/name",
            "title": "Name",
            "type": "string"
          },
          "path": {
            "default": "",
            "title": "Path",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "RepoConfig",
        "type": "object"
      },
      "SourceHealth": {
        "properties": {
          "disabled": {
            "title": "Disabled",
            "type": "boolean"
          },
          "fail_count": {
            "title": "Fail Count",
            "type": "integer"
          },
          "items_24h": {
            "title": "Items 24H",
            "type": "integer"
          },
          "last_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Error"
          },
          "last_ok": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Ok"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "next_run": {
            "title": "Next Run",
            "type": "string"
          },
          "running": {
            "title": "Running",
            "type": "boolean"
          },
          "stale": {
            "default": false,
            "title": "Stale",
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "disabled",
          "running",
          "next_run",
          "last_ok",
          "fail_count",
          "last_error",
          "items_24h"
        ],
        "title": "SourceHealth",
        "type": "object"
      },
      "SourceLatency": {
        "properties": {
          "n": {
            "title": "N",
            "type": "integer"
          },
          "p50": {
            "title": "P50",
            "type": "number"
          },
          "p95": {
            "title": "P95",
            "type": "number"
          },
          "source": {
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "source",
          "n",
          "p50",
          "p95"
        ],
        "title": "SourceLatency",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WatchlistConfig": {
        "properties": {
          "companies": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/CompanyConfig"
            },
            "title": "Companies",
            "type": "array"
          },
          "feeds": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/FeedConfig"
            },
            "title": "Feeds",
            "type": "array"
          },
          "instagram": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/InstagramConfig"
            },
            "title": "Instagram",
            "type": "array"
          },
          "repos": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/RepoConfig"
            },
            "title": "Repos",
            "type": "array"
          }
        },
        "title": "WatchlistConfig",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Drop Radar",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/alerts/disable": {
      "post": {
        "operationId": "alerts_disable_api_alerts_disable_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "default": "",
              "title": "Authorization",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Alerts Disable"
      }
    },
    "/api/alerts/enable": {
      "post": {
        "description": "Give this account its own private ntfy topic (unguessable; the link in Settings is the subscription).",
        "operationId": "alerts_enable_api_alerts_enable_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "default": "",
              "title": "Authorization",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Alerts Enable"
      }
    },
    "/api/alerts/test": {
      "post": {
        "description": "One real push to your own topic, so you can see that your phone receives them.",
        "operationId": "alerts_test_api_alerts_test_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "default": "",
              "title": "Authorization",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Alerts Test"
      }
    },
    "/api/auth/credentials": {
      "put": {
        "description": "Set or change your own username and password; your other sessions are signed out.",
        "operationId": "set_credentials_api_auth_credentials_put",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "default": "",
              "title": "Authorization",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Set Credentials"
      }
    },
    "/api/auth/login": {
      "post": {
        "operationId": "login_api_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Login"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login"
      }
    },
    "/api/auth/logout": {
      "post": {
        "operationId": "logout_api_auth_logout_post",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "default": "",
              "title": "Authorization",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Logout"
      }
    },
    "/api/auth/signup": {
      "post": {
        "operationId": "signup_api_auth_signup_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Signup"
      }
    },
    "/api/config/profile": {
      "get": {
        "operationId": "get_profile_api_config_profile_get",
        "parameters": [
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "default": "",
              "title": "Authorization",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileConfig"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
