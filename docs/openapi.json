    "/api/opportunities": {
      "get": {
        "operationId": "list_opportunities_api_opportunities_get",
        "parameters": [
          {
            "description": "matches: what would alert you; all: everything your sources found",
            "in": "query",
            "name": "include",
            "required": false,
            "schema": {
              "default": "matches",
              "description": "matches: what would alert you; all: everything your sources found",
              "pattern": "^(matches|all)$",
              "title": "Include",
              "type": "string"
            }
          },
          {
            "description": "words that each start a word in the title or company",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "words that each start a word in the title or company",
              "title": "Q"
            }
          },
          {
            "description": "words that each start a word in the location ('seattle', 'ny')",
            "in": "query",
            "name": "location",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "words that each start a word in the location ('seattle', 'ny')",
              "title": "Location"
            }
          },
          {
            "description": "only postings whose location is confirmed US (blank and location-less 'Remote' are left out)",
            "in": "query",
            "name": "us_only",
            "required": false,
            "schema": {
              "default": false,
              "description": "only postings whose location is confirmed US (blank and location-less 'Remote' are left out)",
              "title": "Us Only",
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "company",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Company"
            }
          },
          {
            "in": "query",
            "name": "source",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Source"
            }
          },
          {
            "description": "your status; 'ignored' ones are hidden unless asked for",
            "in": "query",
            "name": "action",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "your status; 'ignored' ones are hidden unless asked for",
              "title": "Action"
            }
          },
          {
            "description": "the posting's own status (New, Open, Closed...); Closed/Expired/Not actionable are hidden unless asked for",
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "the posting's own status (New, Open, Closed...); Closed/Expired/Not actionable are hidden unless asked for",
              "title": "Status"
            }
          },
          {
            "description": "first seen at or after",
            "in": "query",
            "name": "since",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "first seen at or after",
              "title": "Since"
            }
          },
          {
            "description": "deadline within this many days",
            "in": "query",
            "name": "closing_within",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "deadline within this many days",
              "title": "Closing Within"
            }
          },
          {
            "description": "newest first by when it was posted (date-only postings count as that day; none at all falls back to found), by when your sources found it, or by company prestige (S > A > B > C tiers), newest posted within a tier",
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "default": "posted",
              "description": "newest first by when it was posted (date-only postings count as that day; none at all falls back to found), by when your sources found it, or by company prestige (S > A > B > C tiers), newest posted within a tier",
              "pattern": "^(posted|found|prestige)$",
              "title": "Sort",
              "type": "string"
            }
          },
          {
            "description": "false: only new drops; true: only postings that were already open when your sources first looked",
            "in": "query",
            "name": "backfill",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "description": "false: only new drops; true: only postings that were already open when your sources first looked",
              "title": "Backfill"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "default": "",
              "title": "Authorization",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
